{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Dot. Design Tokens",
    "version": "0.1.0",
    "description": "Design token bersama untuk Dot. — dipakai oleh Android (Compose/Glance) dan versi Plasma nanti. Nilai warna hanya didefinisikan di sini, tidak boleh ditulis langsung di kode widget.",
    "source": "PRD-Dot.md §8.5 (palet dasar wajib), §8.1 (font Doto), §8.3 (tema terang/gelap)"
  },
  "color": {
    "black": "#000000",
    "white": "#FFFFFF",
    "gray": {
      "secondary_light": "#666666",
      "secondary_dark": "#999999",
      "inactive": "#444444"
    },
    "accent": {
      "nothing_red": "#D71921",
      "note": "Perkiraan awal dari PRD §16.2 — perlu diverifikasi vs tangkapan layar Nothing OS sebelum rilis."
    },
    "theme": {
      "light": {
        "background": "#FFFFFF",
        "foreground": "#000000",
        "secondary": "#666666",
        "accent": "#D71921",
        "surface": "#F5F5F5",
        "inactive_dot": "#CCCCCC"
      },
      "dark": {
        "background": "#000000",
        "foreground": "#FFFFFF",
        "secondary": "#999999",
        "accent": "#D71921",
        "surface": "#1A1A1A",
        "inactive_dot": "#444444"
      }
    }
  },
  "font": {
    "family": "Doto",
    "file": "fonts/Doto.ttf",
    "license": "SIL Open Font License 1.1",
    "axes": {
      "wght": { "min": 100, "max": 900, "default": 500 },
      "ROND": { "min": 0, "max": 100, "default": 100 }
    },
    "fallback": "monospace",
    "note": "PRD §8.1: uji di Widget Jam apakah font variabel tampil benar di widget; jika tidak, render sebagai bitmap."
  },
  "shape": {
    "radius": {
      "widget": 16,
      "card": 12,
      "button": 8,
      "unit": "dp"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "unit": "dp"
  },
  "dot": {
    "grid": "6x10 per glyph (Doto)",
    "icon_grid": "12x12 untuk ikon widget",
    "gap_ratio": 0.35,
    "note": "PRD §8.2: ikon didefinisikan sebagai pola titik di grid tetap, digambar sebagai lingkaran."
  }
}