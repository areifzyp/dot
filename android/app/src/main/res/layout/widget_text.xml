<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Teks — PRD §6.11 TXT-2. Warna & font di-set dari TextWidgetProvider
     agar mengikuti tema (Terang/Gelap/Ikuti Sistem) dan pilihan font Gaya Nothing;
     nilai di bawah hanya placeholder sebelum update pertama. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:padding="12dp">

    <TextView
        android:id="@+id/text_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:fontFamily="@font/doto"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:text="@string/app_wordmark" />

    <!-- Varian font sistem (GAY-2: pilihan "Font sistem" di layar Gaya). -->
    <TextView
        android:id="@+id/text_widget_content_sans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:fontFamily="sans-serif"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="@string/app_wordmark" />

</FrameLayout>
